{
  "manifest_version": 3,
  "name": "Booking Assistant",
  "version": "10.0.10",
  "description": "AI-powered booking verification for Headout Reservation Operations. Verifies booking details before confirmation to prevent errors.",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://box-office.headout.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_title": "Open Booking Assistant"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  }
}
